# Copy this file to .env, fill in the values below, then `source .env` (or
# `set -a; source .env; set +a` to auto-export) before running ./run.sh.

# Anthropic API key — REQUIRED.
# The hiring team will provide this in your invitation email. Paste it here.
export ANTHROPIC_API_KEY=

# HuggingFace token — OPTIONAL.
# Only needed if your task downloads gated models (e.g. Llama, Gemma) during
# image build. Use your own token from https://huggingface.co/settings/tokens.
# Leave unset if your task doesn't need it.
# export HF_TOKEN=
