# Base image for all RL task execution environments
# This image contains all common dependencies shared across tasks

FROM python:3.12-slim


# Create user matching host for file permissions
ARG USER_ID=1000
ARG USER_NAME=model

RUN groupadd -g ${USER_ID} ${USER_NAME} && \
    useradd -m -u ${USER_ID} -g ${USER_ID} ${USER_NAME} && \
    gpasswd -d ${USER_NAME} root || true && \
    chsh --shell /bin/bash ${USER_NAME}

# Install system dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    bash git curl build-essential sudo vim npm tmux procps iputils-ping jq \
    && apt-get clean

# Install both CLIs for task execution
RUN sudo -u ${USER_NAME} bash -c "curl -fsSL https://claude.ai/install.sh | bash -s 2.1.179" \
  && ln -s /home/${USER_NAME}/.local/bin/claude /usr/local/bin/claude

# Install base Python packages
RUN python -m pip install uv

# Set up the workspace directory for the agent to work in
RUN mkdir -p /workdir
RUN chmod 777 /workdir -R
RUN chown ${USER_NAME}:${USER_NAME} /workdir -R

# Shared HuggingFace cache: root-owned, agent-readable, agent-NOT-writable.
# Routing HF_HOME here (image-wide) means model weights the grader later
# loads cannot be tampered with by the agent, regardless of which task
# built the cache.  Task Dockerfiles should `snapshot_download` / `hf`
# as root (the default) so the resulting files are root-owned.
RUN mkdir -p /opt/huggingface && chmod 755 /opt/huggingface
ENV HF_HOME=/opt/huggingface

# Set up the grader directory (task-specific grader code will be added by task Dockerfiles)
RUN mkdir /grader
RUN chmod 700 /grader
COPY --chmod=600 docker/grader/run_grader.py /grader/run_grader.py

# Set up agents/engines
COPY --chown=${USER_NAME} docker/container-internal-claude.json /home/${USER_NAME}/.claude.json
RUN sudo -u ${USER_NAME} mkdir -p /home/${USER_NAME}/.claude
COPY --chown=${USER_NAME} docker/autoexit-claude-settings.json /home/${USER_NAME}/.claude/settings.json
COPY .codex* /home/${USER_NAME}/

# Directory for the logs to go into
RUN mkdir /logs

# Make USER_NAME available as environment variable for entrypoint
ENV USER_NAME=${USER_NAME}

# Copy unified entrypoint script (combines task execution and grading)
COPY --chmod=500 docker/entrypoint.sh /entrypoint.sh

COPY --chmod=500 docker/run-agent-tmux.sh /run-agent-tmux.sh

# Copy the tmux config in so that we can get a bigger scrollback buffer for the
# logs.
COPY --chown=${USER_NAME} docker/container-tmux.conf /home/${USER_NAME}/.tmux.conf

# Copy TPU environment configuration (generated by task_runner.py from host metadata)
COPY --chmod=644 docker/tpu-env.sh /etc/tpu-env.sh

# Run as root (entrypoint will su to USER_NAME for agent execution)
ENTRYPOINT ["/entrypoint.sh"]
